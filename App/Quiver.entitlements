<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Quiver is not sandboxed: AutoRaise needs the Accessibility API and a
         CGEventTap, and the Hosts module writes to /etc/hosts via an admin helper.
         App Sandbox would block all of these. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
